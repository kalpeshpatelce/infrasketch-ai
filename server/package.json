{
  "name": "infrasketch-ai-server",
  "version": "1.0.0",
  "description": "InfraSketch AI Backend - IaC generation API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch -r dotenv/config src/index.ts",
    "dev:win": "node_modules\\.bin\\tsx.cmd -r dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node -r dotenv/config dist/index.js",
    "lint": "eslint src/"
  },
  "dependencies": {
    "archiver": "7.0.1",
    "better-sqlite3": "11.7.0",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "morgan": "1.10.0",
    "openai": "4.77.0",
    "uuid": "11.0.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/better-sqlite3": "7.6.12",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/morgan": "1.9.9",
    "@types/node": "22.10.5",
    "@types/uuid": "10.0.0",
    "eslint": "9.17.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
